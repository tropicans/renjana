# Renjana LMS - Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ─────────────────────────────────────────────
# For Docker: use the service name "postgres" as hostname
DATABASE_URL="postgresql://renjana:renjana_dev@postgres:5432/renjana_db"

# For local dev (outside Docker): use localhost
# DATABASE_URL="postgresql://renjana:renjana_dev@localhost:25432/renjana_db"

# ─── NextAuth ─────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-random-string-yang-panjang"
NEXTAUTH_URL="http://localhost:3214"

# ─── App ──────────────────────────────────────────────────
NODE_ENV=production

# ─── Midtrans Payment Gateway ────────────────────────────────
# Supported value: MIDTRANS
NEXT_PUBLIC_PAYMENT_PROVIDER="MIDTRANS"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_API_BASE_URL="https://app.sandbox.midtrans.com"
MIDTRANS_CORE_API_BASE_URL="https://api.sandbox.midtrans.com"
